
# Optional public weather widget: credentials stay on the server, never NEXT_PUBLIC.
# Set a NEW private credential in server/.env.local; do not reuse the exposed legacy source key.
# QWEATHER_API_HOST=your-account-host.qweatherapi.com
# QWEATHER_API_KEY=your-private-api-key
# QWEATHER_LOCATION=101280601
# QWEATHER_CITY=深圳
# STZH_WEATHER_ENABLED=1
